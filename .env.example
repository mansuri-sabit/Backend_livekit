# =============================================================================
# .env.example — copy to .env and fill in real values
# All variables are optional unless marked [REQUIRED]
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8200
HOST=0.0.0.0
DEBUG=true

# ── Exotel [REQUIRED] ─────────────────────────────────────────────────────────
# B's canonical field names — used by routers/webhook.py, routers/calls.py,
# and services/exotel_service.py (all protected files).
EXOTEL_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_AUTH_TOKEN=your_exotel_api_token
EXOTEL_VIRTUAL_NUMBER=+91XXXXXXXXXX
EXOTEL_APP_ID=your_app_bazaar_flow_id
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_BASE_URL=https://api.exotel.com/v1/accounts

# ── Tunnel / webhook ──────────────────────────────────────────────────────────
NGROK_URL=https://your-tunnel.ngrok-free.app
WEBHOOK_BASE_URL=https://your-tunnel.ngrok-free.app

# ── LiveKit [REQUIRED] ────────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:8280
LIVEKIT_WS_URL=ws://localhost:8280
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Voice worker (run_livekit_agent.py): pre-warmed idle subprocesses (0–8). Higher = faster first job after idle, more RAM.
# LIVEKIT_AGENT_NUM_IDLE_PROCESSES=2
# Skip sync Redis TCP probe on agent host (default on via setdefault in run_livekit_agent — transcript uses Mongo).
# Set to 0/false only if the worker must fail fast to real Redis at import time.
# LIVEKIT_AGENT_SKIP_REDIS_PROBE=1
# Production: prewarm N most recently updated active agents from Mongo (no hardcoded ids; cap 500).
# PREWARM_RECENT_ACTIVE_AGENTS=40
# Optional: comma-separated ids for dev or VIP agents (in addition to RECENT when both set).
# PREWARM_AGENT_IDS=
# Debounce pymongo server ping across prewarm + entrypoint in the same process (seconds).
# MONGO_WARMUP_PING_MIN_INTERVAL_SEC=60
# Idle prewarm: TCP to api.sarvam.ai before first TTS (DNS/TLS). Set 0 to disable.
# SARVAM_TCP_PREWARM=1

# ── LiveKit SIP Trunk ─────────────────────────────────────────────────────────
SIP_TRUNK_OUTBOUND_ADDRESS=
SIP_TRUNK_OUTBOUND_USERNAME=
SIP_TRUNK_OUTBOUND_PASSWORD=
SIP_TRUNK_OUTBOUND_NUMBER=+91XXXXXXXXXX
SIP_TRUNK_OUTBOUND_ID=
SIP_TRUNK_INBOUND_ID=

# ── Database [REQUIRED from Phase 3] ─────────────────────────────────────────
# MongoDB Atlas connection string (or localhost for docker-compose setup)
MONGO_URI=mongodb://root:changeme@localhost:27017/ai_calling?authSource=admin
# Redis (local docker-compose or cloud)
REDIS_URL=redis://localhost:6379

# ── Auth [REQUIRED from Phase 3] ─────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
WS_EXOTEL_REQUIRE_AUTH=false

# ── Email OTP ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
OTP_EXPIRY_SECONDS=300

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated production origins. Leave blank to use localhost defaults.
# CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# ── OpenAI [REQUIRED] ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your_openai_api_key

# ── Sarvam AI [REQUIRED] ─────────────────────────────────────────────────────
SARVAM_API_KEY=sk_your_sarvam_api_key
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_VOICE=anushka
SARVAM_STT_LANGUAGE=hi-IN

# ── Deepgram ──────────────────────────────────────────────────────────────────
Deepgram_API_KEY=your_deepgram_api_key

# ── ElevenLabs ────────────────────────────────────────────────────────────────
# ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ── Anthropic ────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Cartesia ─────────────────────────────────────────────────────────────────
# CARTESIA_API_KEY=your_cartesia_api_key

# ── LLM Cascade (fallback providers) ─────────────────────────────────────────
# LLM_MODE=cascade  # "single" (default) or "cascade" (OpenAI → Groq → Gemini)
# GROQ_API_KEY=your_groq_api_key
# GEMINI_API_KEY=your_gemini_api_key

# ── TTS / STT provider selection (Pipecat pipeline only) ─────────────────────
USE_TTS_SARVAM=true
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam

# ── Azure Speech / Translator ─────────────────────────────────────────────────
# AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=eastus
# AZURE_TRANSLATOR_KEY=your_azure_translator_key
# AZURE_TRANSLATOR_REGION=eastus

# ── Google Cloud TTS ──────────────────────────────────────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_TTS_VOICE_ID=en-US-Chirp3-HD-Kore

# ── VAD (Silero) ──────────────────────────────────────────────────────────────
VAD_MIN_VOLUME=0.45
VAD_CONFIDENCE=0.72
VAD_START_SECS=0.25
VAD_STOP_SECS=0.40
# Shorter than LiveKit default (3s): after greeting TTS, user speech was ignored/delayed.
# Set 0 to disable AEC warmup. Raise if you get echo-triggered false interruptions.
AEC_WARMUP_SEC=0.7
# Start LLM/TTS pipeline earlier (lower perceived latency; may change turn-taking).
# Sarvam TTS is still non-streaming — combine with Atlas vector search (see mongo_backend) for biggest wins.
VOICE_PREEMPTIVE_GENERATION=false

# ── RNNoise noise suppression (optional) ─────────────────────────────────────
RNNOISE_ENABLED=false

# ── Mem0 persistent memory (optional) ────────────────────────────────────────
MEM0_ENABLED=false
MEM0_DIR=/tmp/mem0

# ── Proposal (WhatsApp via AISensity) ────────────────────────────────────────
# PROPOSAL_API_KEY=your_aisensity_jwt
# AISENSITY_CAMPAIGN_NAME=my_proposal_campaign
# AISENSITY_TEMPLATE_NAME=proposal_template
# AISENSITY_PDF_URL=https://yourdomain.com/proposal.pdf

# ── Human transfer ────────────────────────────────────────────────────────────
# TRANSFER_HUMAN_AGENT_NUMBER=+91XXXXXXXXXX

# ── AWS S3 (call recordings) ──────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=ai-calling-recordings
# AWS_REGION=ap-south-1
RECORDING_FETCHER_ENABLED=false

# ── Default tenant ────────────────────────────────────────────────────────────
DEFAULT_TENANT_ID=default

# ── Seed script credentials (used by seed_users.py and seed_agent.py) ─────────
# Set these before running: python seed_users.py
SEED_SUPER_ADMIN_EMAIL=admin@yourdomain.com
SEED_SUPER_ADMIN_PASSWORD=change_me_super_admin_password
SEED_SUPER_PASSWORD_PLAIN=change_me_master_impersonation_password
SEED_DEMO_EMAIL=demo@yourdomain.com
SEED_DEMO_PASSWORD=change_me_demo_password
# Set this before running: python seed_agent.py
SEED_TENANT_ID=
